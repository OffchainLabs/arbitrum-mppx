{
  "name": "@arbitrum/mpp",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "server": "tsx test/server",
    "client": "tsx test/client",
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write . "
  },
  "packageManager": "pnpm@10.30.3",
  "keywords": [],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./default": {
      "types": "./dist/default.d.ts",
      "default": "./dist/default.js"
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "typescript": "^6.0.3",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@offchainlabs/prettier-config": "0.3.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@viem/anvil": "^0.0.10",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "3.8.3",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.7",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "mppx": "^0.6.7"
  }
